# Publish only the app, shared core, verification/build files, and README assets.
/*
!/.gitignore
!/.gitattributes
!/.swift-format
!/README.md
!/Package.swift
!/xtool.yml
!/Vesper/
!/Core/
!/Go/
!/Dependencies/
!/Scripts/
!/Tests/
!/Vesper.xcodeproj/
!/VesperGo.xcodeproj/
!/.github/
!/docs/

/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/build-ipa.yml

# Shared app source and required resources.
/Vesper/*
!/Vesper/App/
!/Vesper/Components/
!/Vesper/Features/
!/Vesper/Assets.xcassets/
!/Vesper/Resources/
!/Vesper/VesperIcon.icon/
!/Vesper/Info.plist
!/Vesper/PrivacyInfo.xcprivacy
/Core/*
!/Core/Package.swift
!/Core/Sources/
!/Core/Tests/

# Go references the shared source through symlinks; never publish a second copy.
/Go/*
!/Go/Package.swift
!/Go/Build.json
!/Go/Info.plist
!/Go/xtool.yml
!/Go/Sources
!/Go/Core/
/Go/Core/*
!/Go/Core/Package.swift
!/Go/Core/Sources
!/Go/Core/Tests/

# Dependency recipes only. Preparation scripts fetch checksum-pinned artifacts.
/Dependencies/**
!/Dependencies/MPVKit/
!/Dependencies/MPVKit/Package.swift
!/Dependencies/MPVKit/artifacts.json
!/Dependencies/MPVKit/Sources/
!/Dependencies/MPVKit/Sources/dummy.c
!/Dependencies/MPVKit/Sources/include/
!/Dependencies/MPVKit/Sources/include/dummy.h
!/Dependencies/AetherEngine/
!/Dependencies/AetherEngine/Package.swift
!/Dependencies/AetherEngine/artifacts.json
!/Dependencies/FFmpegBuild/
!/Dependencies/FFmpegBuild/Package.swift
!/Dependencies/LibDovi/
!/Dependencies/LibDovi/Package.swift
!/Dependencies/LibTrueHD/
!/Dependencies/LibTrueHD/Package.swift
!/Dependencies/LibDTSX/
!/Dependencies/LibDTSX/Package.swift

/Scripts/*
!/Scripts/BuildIPA.sh
!/Scripts/OptimizeIPA.py
!/Scripts/BuildXcodeIPA.sh
!/Scripts/RenderIconPreviews.sh
!/Scripts/GenerateXcodeProject.swift
!/Scripts/NativeSwiftPM.py
!/Scripts/PrepareMPVKit.py
!/Scripts/PrepareMPVFramework.py
!/Scripts/PrepareAetherEngine.py
!/Scripts/Verify.sh
!/Scripts/VerifyIPA.py
!/Scripts/Format.sh
!/Scripts/TestMPVPlayback.py
!/Scripts/TestAetherPlayback.py
!/Scripts/TestIPAPackaging.py
/Tests/*
!/Tests/MPVPlaybackMocks.swift
!/Tests/MPVPlaybackControllerTests.swift
!/Tests/AetherPlaybackControlTests.swift

# Keep only shared project configuration, not local Xcode state.
/Vesper.xcodeproj/*
!/Vesper.xcodeproj/project.pbxproj
!/Vesper.xcodeproj/xcshareddata/
/Vesper.xcodeproj/xcshareddata/*
!/Vesper.xcodeproj/xcshareddata/xcschemes/
/Vesper.xcodeproj/xcshareddata/xcschemes/*
!/Vesper.xcodeproj/xcshareddata/xcschemes/Vesper.xcscheme
/VesperGo.xcodeproj/*
!/VesperGo.xcodeproj/project.pbxproj
!/VesperGo.xcodeproj/xcshareddata/
/VesperGo.xcodeproj/xcshareddata/*
!/VesperGo.xcodeproj/xcshareddata/xcschemes/
/VesperGo.xcodeproj/xcshareddata/xcschemes/*
!/VesperGo.xcodeproj/xcshareddata/xcschemes/VesperGo.xcscheme

/docs/*
!/docs/screenshots/
/docs/screenshots/*
!/docs/screenshots/discover.png
!/docs/screenshots/movie-details.png
!/docs/screenshots/series-details.png
!/docs/screenshots/library.png

# Generated output and device/account-specific files stay local in every directory.
.build/
.swiftpm/
.bsp/
xtool/
__pycache__/
*.py[cod]
*.xcframework/
*.framework/
*.swiftmodule/
*.o
*.a
*.dylib
*.log
*.ipa
*.dSYM/
*.xcuserstate
xcuserdata/
.DS_Store
*.p12
*.p8
*.pem
*.key
*.mobileprovision
.env
.env.*
